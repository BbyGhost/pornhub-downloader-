{
  "manifest_version": 3,
  "name": "Universal Video Downloader",
  "version": "2.2.0",
  "description": "Site-agnostic downloader for browser-accessible video resources with HLS/DASH detection and optional MP4 conversion.",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "webRequest"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8765/*"],
  "action": {"default_popup": "popup.html"},
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
